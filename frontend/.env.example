# Base URL of the Queryll API (Instance 2). No trailing slash.
# Local dev, with the API running on its default port:
VITE_API_BASE_URL=http://localhost:8000

# In production this is the Render Web Service origin, e.g.
# VITE_API_BASE_URL=https://queryll-api.onrender.com

# Dev only: run the UI against the in-memory mock backend in src/dev/mockBackend.ts, with no API
# process at all. Uploads ingest on a timer and answers stream with real citations.
#   VITE_MOCK_API=1

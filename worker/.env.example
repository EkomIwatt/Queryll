# Queryll ingestion worker — environment.
#
# Copy to `.env` for local development. `.env` is gitignored; never commit a real key.

# --- Database ------------------------------------------------------------------------------
# The dev database is on host port 5433, not 5432: Snipp already holds 5432 on this machine.
# Start it from the repo root with `docker compose up -d db`.
DATABASE_URL=postgresql+asyncpg://queryll:queryll@localhost:5433/queryll

# --- Embeddings (Contract 4) ----------------------------------------------------------------
# These names and defaults are identical on the API side, written independently. If the two
# processes ever disagree here, nothing crashes — retrieval quietly returns near-random
# passages and both test suites stay green. Changing EMBEDDING_MODEL means re-indexing every
# document; changing EMBEDDING_DIM is a schema change, which is an ESCALATION.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIM=1024

# At most 128 inputs per request (the Voyage ceiling). The worker uses a smaller batch for
# small documents so the progress bar moves more than once.
EMBEDDING_BATCH_SIZE=128

# "voyage" or "fake". `fake` is the deterministic test embedder: it produces noise, so
# retrieval over a fake-embedded library is meaningless. Local development only.
EMBEDDING_PROVIDER=voyage

# --- Chunking (Contract 5) -------------------------------------------------------------------
# Chunk shape is a quality knob, not a constant. Tuning these against real documents is
# expected work; re-index afterwards, because chunk boundaries change.
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
CHUNK_MIN_TOKENS=32

# --- Limits (Contract 5 §1) -------------------------------------------------------------------
# Chosen so a worst-case document finishes inside the 15-minute reclaim window.
MAX_PAGES=500
MAX_FILE_BYTES=20971520

# --- Runtime ------------------------------------------------------------------------------------
# WORKER_ID lands in `ingestion_jobs.locked_by` for observability. Leave it unset in production
# and each process names itself after its host.
# WORKER_ID=
WORKER_POLL_INTERVAL_SECONDS=2.0
WORKER_MAX_ATTEMPTS=3
LOG_LEVEL=INFO

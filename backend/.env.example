# Queryll API (Instance 2) — copy to `.env` and fill in.
#
# The embedding block is FROZEN by Contract 4 and is read from these exact names, with
# these exact defaults, by BOTH this API and the ingestion worker. If the two processes
# ever disagree about any of these four values, nothing crashes: retrieval quietly
# returns near-random passages, Claude faithfully answers from them, and both test
# suites stay green. Change them in both places or in neither.

# ---------------------------------------------------------------------------
# Database — host port is 5433, not 5432 (Snipp already holds 5432 on this machine).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://queryll:queryll@localhost:5433/queryll
DB_ECHO=false

# ---------------------------------------------------------------------------
# Auth (Contract 1)
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Production (Vercel -> Render is cross-site) needs Secure + SameSite=None.
# Local development over plain http:// cannot store a Secure cookie, so flip both.
COOKIE_SECURE=true
COOKIE_SAMESITE=none
# COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# CORS (Contract 9) — comma-separated, credentials are allowed so "*" is not an option.
# Must include the Vercel production domain AND the preview domains.
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Embeddings — Contract 4. FROZEN. Must match the worker exactly.
# ---------------------------------------------------------------------------
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIM=1024

# ---------------------------------------------------------------------------
# Retrieval — Contract 7 §4. ASSUMED starting values; tuning these against real
# documents is expected work, which is why they are config and not constants.
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SIMILARITY=0.35
RETRIEVAL_PER_DOCUMENT_CAP=4
# HNSW is approximate and pgvector applies the tenant filter after the index scan, so a
# user-scoped query can come back short. Over-fetch, then cap and floor.
RETRIEVAL_CANDIDATE_MULTIPLIER=6
HNSW_EF_SEARCH=100

# ---------------------------------------------------------------------------
# Answering — Contract 7
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-5
ANSWER_MAX_TOKENS=4096
# "disabled" (default) or "adaptive". Grounded extraction over eight passages does not
# need reasoning, and time-to-first-token is what this product is judged on.
ANSWER_THINKING=disabled
# Optional: low | medium | high | xhigh | max. Omitted entirely when blank.
ANSWER_EFFORT=
HISTORY_MAX_MESSAGES=6
SSE_HEARTBEAT_SECONDS=15

# ---------------------------------------------------------------------------
# Uploads — Contract 5 §1 / Contract 6 §1
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=20971520
